# Copy this file to deploy/env/autosign.env, then fill in real values.
# Do not commit real env files.

ZJU_USERNAME=
ZJU_PASSWORD=

# Optional: AUTO scans all known radar points. You can also pass --raderAt
# through the container command when you want a different value.
# AUTOSIGN_RADER_AT=AUTO

ENABLE_DINGTALK=false
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

CLASSROOM_DOWNLOAD_PATH=/data/downloads

# Optional container entrypoint controls. Leave both blank for autosign.
# LIVE_BETTER_SCRIPT=classroom.zju/generateCourseMd.js
# LIVE_BETTER_ARGS=--accounts-file /data/accounts.json --raderAt AUTO
