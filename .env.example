ZJU_USERNAME=
ZJU_PASSWORD=

# For pintia.cn (Optional)
# Copy the Cookie request header from a logged-in browser session.
PINTIA_COOKIE=

# For DingTalk notification(Optional)
ENABLE_DINGTALK=false
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# For the grade monitor (Optional; defaults shown below)
GRADE_STATE_PATH="state/grades.json"
GRADE_MONITOR_START_HOUR=8
GRADE_MONITOR_END_HOUR=24
GRADE_MONITOR_INTERVAL_SECONDS=3600
GRADE_REQUEST_TIMEOUT_MS=20000
GRADE_NOTIFY_INITIAL=false
GRADE_CHECK_EVALUATION=true
